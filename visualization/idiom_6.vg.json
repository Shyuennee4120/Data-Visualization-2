{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 450,
  "height": 400,

  "data": {
    "url": "../data/national_passenger_travel.csv"
  },

  "transform": [
    {
      "filter": "datum['Financial year'] === '1974-75' || datum['Financial year'] === '2024-25'"
    },
    {
      "fold": [
        "Passenger cars",
        "Buses",
        "Rail",
        "Air",
        "Other "
      ],
      "as": ["Mode", "Passenger_km"]
    },
    {
      "calculate": "toNumber(datum.Passenger_km)",
      "as": "Travel"
    },
    {
      "calculate": "trim(datum.Mode)",
      "as": "Mode"
    },
    {
      "pivot": "Financial year",
      "value": "Travel",
      "groupby": ["Mode"]
    },
    {
      "filter": "isValid(datum['1974-75']) && isValid(datum['2024-25']) && datum['1974-75'] > 0"
    },
    {
      "calculate": "(datum['2024-25'] - datum['1974-75']) / datum['1974-75'] * 100",
      "as": "Growth_pct"
    }
  ],

  "mark": {
    "type": "bar",
    "size": 35
  },

  "encoding": {
    "y": {
      "field": "Mode",
      "type": "nominal",
      "sort": "-x",
      "title": "Transport mode"
    },
    "x": {
      "field": "Growth_pct",
      "type": "quantitative",
      "title": "Growth in passenger travel (%)",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "Mode",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {
        "field": "Mode",
        "type": "nominal",
        "title": "Transport mode"
      },
      {
        "field": "1974-75",
        "type": "quantitative",
        "title": "1974–75 (billion passenger km)",
        "format": ".2f"
      },
      {
        "field": "2024-25",
        "type": "quantitative",
        "title": "2024–25 (billion passenger km)",
        "format": ".2f"
      },
      {
        "field": "Growth_pct",
        "type": "quantitative",
        "title": "Growth (%)",
        "format": ".1f"
      }
    ]
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Ranked by national passenger kilometres, 1974-75 to 2024-25",
  "width": 550,
  "height": 350,
  "data": {
    "url": "../data/national_passenger_travel.csv"
  },
  "transform": [
    {
      "fold": [
        "Passenger cars",
        "Buses",
        "Rail",
        "Air",
        "Other "
      ],
      "as": [
        "Mode",
        "Passenger_km"
      ]
    },
    {
      "calculate": "toNumber(datum.Passenger_km)",
      "as": "Travel"
    },
    {
      "calculate": "toNumber(substring(datum['Financial year'], 0, 4))",
      "as": "Year_start"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Travel",
          "order": "descending"
        }
      ],
      "groupby": [
        "Financial year"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Year_start",
          "as": "Latest_year"
        }
      ]
    },
    {
      "calculate": "datum.Year_start === datum.Latest_year ? datum.Rank : null",
      "as": "Latest_rank_value"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Latest_rank_value",
          "as": "Latest_rank"
        }
      ],
      "groupby": [
        "Mode"
      ]
    },
    {
      "calculate": "datum.Latest_rank <= 3 ? trim(datum.Mode) : 'Other modes'",
      "as": "Highlight_group"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 3,
    "point": {
      "filled": true,
      "size": 65
    }
  },
  "encoding": {
    "x": {
      "field": "Year_start",
      "type": "quantitative",
      "title": "Financial year starting",
      "scale": {
        "zero": false
      },
      "axis": {
        "format": "d",
        "tickCount": 10
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "title": "Rank by passenger travel",
      "scale": {
        "domain": [
          1,
          5
        ],
        "reverse": true,
        "zero": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "format": "d"
      }
    },
    "color": {
      "field": "Highlight_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Passenger cars",
          "Air",
          "Other",
          "Other modes"
        ],
        "range": [
          "#2878b5",
          "#d97732",
          "#27866f",
          "#cccccc"
        ]
      },
      "legend": {
        "title": "Top 3 modes in 2024-25",
        "orient": "bottom"
      }
    },
    "order": {
      "field": "Year_start",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "Financial year",
        "type": "ordinal"
      },
      {
        "field": "Mode",
        "type": "nominal"
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "Travel",
        "type": "quantitative",
        "title": "Billion passenger km",
        "format": ".2f"
      }
    ],
    "detail": {
      "field": "Mode",
      "type": "nominal"
    }
  }
}

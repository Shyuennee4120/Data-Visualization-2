{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 400,
  "height": 400,

  "data": {
    "url": "../data/capital_city_passenger_travel.csv",
    "format": {
      "type": "csv"
    }
  },

  "params": [
    {
      "name": "Year_selection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1976,
        "max": 2024,
        "step": 1,
        "name": "Financial year starting: "
      }
    }
  ],

  "transform": [
    {
      "calculate": "toNumber(substring(datum['Financial year'], 0, 4))",
      "as": "Year_start"
    },
    {
      "filter": "datum.Year_start === Year_selection"
    },
    {
      "fold": [
        "Passenger cars",
        "Commercial vehicles",
        "Motor cycles",
        "Heavy rail",
        "Light rail",
        "Bus",
        "Ferry"
      ],
      "as": ["Mode_raw", "Passenger_km"]
    },
    {
      "calculate": "trim(datum.Mode_raw)",
      "as": "Mode"
    },
    {
      "calculate": "datum.Passenger_km == null || datum.Passenger_km === '' ? null : toNumber(datum.Passenger_km)",
      "as": "Travel"
    },
    {
      "calculate": "toNumber(datum.Total)",
      "as": "City_total"
    },
    {
      "calculate": "isValid(datum.Travel) && datum.City_total > 0 ? datum.Travel / datum.City_total : null",
      "as": "Mode_share"
    },
    {
      "calculate": "indexof(['Passenger cars', 'Commercial vehicles', 'Motor cycles', 'Heavy rail', 'Light rail', 'Bus', 'Ferry'], datum.Mode)",
      "as": "Mode_order"
    }
  ],

  "mark": {
    "type": "line",
    "strokeWidth": 2,
    "opacity": 0.65,
    "point": {
      "filled": true,
      "size": 45
    }
  },

  "encoding": {
    "x": {
      "field": "Mode",
      "type": "ordinal",
      "sort": [
        "Passenger cars",
        "Commercial vehicles",
        "Motor cycles",
        "Heavy rail",
        "Light rail",
        "Bus",
        "Ferry"
      ],
      "title": "Transport mode",
      "axis": {
        "labelAngle": -25,
        "labelLimit": 180,
        "grid": true,
        "gridColor": "#dddddd",
        "tickSize": 1
      }
    },

    "y": {
      "field": "Mode_share",
      "type": "quantitative",
      "title": "Share of passenger kilometres",
      "scale": {
        "domain": [0, 1]
      },
      "axis": {
        "format": ".0%",
        "values": [
          0,
          0.2,
          0.4,
          0.6,
          0.8,
          1
        ],
        "grid": false
      }
    },

    "color": {
      "field": "City",
      "type": "nominal",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "title": "Capital city",
        "orient": "right"
      }
    },

    "detail": {
      "field": "City",
      "type": "nominal"
    },

    "order": {
      "field": "Mode_order",
      "type": "quantitative"
    },

    "tooltip": [
      {
        "field": "City",
        "type": "nominal"
      },
      {
        "field": "Financial year",
        "type": "ordinal"
      },
      {
        "field": "Mode",
        "type": "nominal",
        "title": "Transport mode"
      },
      {
        "field": "Travel",
        "type": "quantitative",
        "title": "Billion passenger km",
        "format": ".2f"
      },
      {
        "field": "Mode_share",
        "type": "quantitative",
        "title": "Mode share",
        "format": ".2%"
      }
    ]
  }
}
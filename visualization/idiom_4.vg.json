{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "1976-77 to 2024-25: Slider selects the financial year's starting year",
  "width": 500,
  "height": 450,
  "params": [
    {
      "name": "Year_selection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1976,
        "max": 2024,
        "step": 1,
        "name": "Financial year starting: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "aus_state.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgrey",
        "stroke": "darkgrey",
        "strokeWidth": 1
      }
    },
    {
      "encoding": {
        "text": {
          "field": "State",
          "type": "nominal"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "color": "grey"
      },
      "data": {
        "values": [
          {
            "latitude": -25,
            "State": "Western Australia",
            "longitude": 121
          },
          {
            "latitude": -20,
            "State": "Northern Territory",
            "longitude": 133.5
          },
          {
            "latitude": -30,
            "State": "South Australia",
            "longitude": 134
          },
          {
            "latitude": -22,
            "State": "Queensland",
            "longitude": 144
          },
          {
            "latitude": -32,
            "State": "New South Wales",
            "longitude": 146
          },
          {
            "latitude": -37,
            "State": "Victoria",
            "longitude": 142.5
          },
          {
            "latitude": -44,
            "State": "Tasmania",
            "longitude": 145.5
          },
          {
            "latitude": -36.2,
            "State": "Australian Capital Territory",
            "longitude": 154
          }
        ]
      }
    },
    {
      "data": {
        "url": "../data/capital_city_passenger_travel.csv"
      },
      "transform": [
        {
          "calculate": "toNumber(substring(datum['Financial year'], 0, 4))",
          "as": "Year_start"
        },
        {
          "filter": "datum.Year_start === Year_selection"
        },
        {
          "lookup": "City",
          "from": {
            "data": {
              "url": "../data/city_coordinates.csv"
            },
            "key": "City",
            "fields": [
              "latitude",
              "longitude"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#2878b5",
        "opacity": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Passenger cars",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ],
            "range": [
              0,
              2000
            ]
          },
          "legend": {
            "title": "Billion passenger km"
          }
        },
        "tooltip": [
          {
            "field": "City",
            "type": "nominal"
          },
          {
            "field": "Financial year",
            "type": "ordinal"
          },
          {
            "field": "Passenger cars",
            "type": "quantitative",
            "title": "Car travel (billion passenger km)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "encoding": {
        "text": {
          "field": "City",
          "type": "nominal"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        }
      },
      "mark": {
        "dx": 8,
        "color": "black",
        "align": "left",
        "fontWeight": "bold",
        "fontSize": 10,
        "dy": -10,
        "type": "text"
      },
      "data": {
        "url": "../data/city_coordinates.csv"
      }
    }
  ]
}
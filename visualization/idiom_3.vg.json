{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "(Share of employed people, Census day 2021)"
  },
  "width": 500,
  "height": 500,
  "data": {
    "url": "../data/state_commuting.csv"
  },
  "transform": [
    {
      "fold": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "as": [
        "State",
        "People"
      ]
    },
    {
      "filter": "datum.Vehicles === 'Car, as driver' || datum.Vehicles === 'Total'"
    },
    {
      "calculate": "toNumber(datum.People)",
      "as": "People_count"
    },
    {
      "pivot": "Vehicles",
      "value": "People_count",
      "groupby": [
        "State"
      ]
    },
    {
      "calculate": "datum['Car, as driver'] / datum.Total",
      "as": "Car_driver_share"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "aus_state.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.STATE_NAME"
      },
      "as": "Boundary"
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "Boundary",
          "type": "geojson"
        },
        "color": {
          "field": "Car_driver_share",
          "type": "quantitative",
          "scale": {
            "scheme": "browns"
          },
          "legend": {
            "title": "Car-driver proportion",
            "format": ".0%"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Car_driver_share",
            "type": "quantitative",
            "title": "Car-driver proportion",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Label": "Western Australia",
            "longitude": 122,
            "latitude": -25
          },
          {
            "Label": "Northern Territory",
            "longitude": 133.5,
            "latitude": -19.5
          },
          {
            "Label": "South Australia",
            "longitude": 135,
            "latitude": -30
          },
          {
            "Label": "Queensland",
            "longitude": 145,
            "latitude": -22
          },
          {
            "Label": "New South Wales",
            "longitude": 147,
            "latitude": -32
          },
          {
            "Label": "Victoria",
            "longitude": 144.5,
            "latitude": -37
          },
          {
            "Label": "Tasmania",
            "longitude": 146.5,
            "latitude": -42
          },
          {
            "Label": "Australian Capital Territory",
            "longitude": 149.1,
            "latitude": -35.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.State === 'Tasmania'"
        },
        {
          "calculate": "141",
          "as": "Note_lon"
        },
        {
          "calculate": "-43.5",
          "as": "Note_lat"
        },
        {
          "calculate": "'Tasmania: ' + format(datum.Car_driver_share, '.1%')",
          "as": "Note_title"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Note_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Note_lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#6b3925",
            "strokeWidth": 1.3
          },
          "encoding": {
            "longitude2": {
              "datum": 146.5
            },
            "latitude2": {
              "datum": -42.7
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#6b3925",
            "align": "right",
            "dx": -7,
            "dy": -14
          },
          "encoding": {
            "text": {
              "field": "Note_title"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "color": "#19313c",
            "align": "right",
            "dx": -7,
            "dy": 4,
            "lineHeight": 13
          },
          "encoding": {
            "text": {
              "value": [
                "Highest car-driver proportion",
                "of employed people (2021)"
              ]
            }
          }
        }
      ]
    }
  ]
}

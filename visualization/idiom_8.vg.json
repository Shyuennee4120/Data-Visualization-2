{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 400,
  "data": {
    "url": "../data/state_commuting.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "as": [
        "State",
        "People"
      ]
    },
    {
      "calculate": "datum.People == null || datum.People === '' ? null : toNumber(datum.People)",
      "as": "People_count"
    },
    {
      "calculate": "datum.Vehicles === 'Total' ? datum.People_count : null",
      "as": "Total_value"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Total_value",
          "as": "Employed_total"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "filter": "indexof(['Total', 'Worked at home', 'Did not go to work', 'Not stated'], datum.Vehicles) < 0"
    },
    {
      "filter": "isValid(datum.People_count) && datum.Employed_total > 0"
    },
    {
      "calculate": "datum.People_count / datum.Employed_total",
      "as": "Mode_share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "Mode_share",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "scheme": "yellowgreenblue",
            "zero": true
          },
          "legend": {
            "title": "Share of employed people",
            "format": ".1%",
            "values": [
              0,
              0.01,
              0.05,
              0.1,
              0.3,
              0.6
            ],
            "gradientLength": 240,
            "titleLimit": 220,
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "Vehicles",
            "type": "nominal",
            "title": "Travel method"
          },
          {
            "field": "People_count",
            "type": "quantitative",
            "title": "People",
            "format": ",.0f"
          },
          {
            "field": "Employed_total",
            "type": "quantitative",
            "title": "All employed people",
            "format": ",.0f"
          },
          {
            "field": "Mode_share",
            "type": "quantitative",
            "title": "Share of employed people",
            "format": ".2%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.State === 'Tasmania' && datum.Vehicles === 'Car, as driver'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "red",
        "strokeWidth": 2
      }
    },
    {
      "transform": [
        {
          "filter": "datum.State === 'Northern Territory' && datum.Vehicles === 'Walked only'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "brown",
        "strokeWidth": 2
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Rows"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "top",
        "color": "black"
      },
      "encoding": {
        "x": {
          "value": 398
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": [
            "Driving leads in every",
            "state and territory"
          ]
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Rows"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "normal",
        "align": "left",
        "baseline": "top",
        "color": "brown"
      },
      "encoding": {
        "x": {
          "value": 398
        },
        "y": {
          "value": 38
        },
        "text": {
          "value": [
            "43.4% in NSW, compared",
            "with 64.6% in Tasmania."
          ]
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Rows"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "top",
        "color": "black"
      },
      "encoding": {
        "x": {
          "value": 398
        },
        "y": {
          "value": 325.33
        },
        "text": {
          "value": [
            "Walking stands out in",
            "the Northern Territory"
          ]
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Rows"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "normal",
        "align": "left",
        "baseline": "top",
        "color": "brown"
      },
      "encoding": {
        "x": {
          "value": 398
        },
        "y": {
          "value": 363.33
        },
        "text": {
          "value": [
            "7.6% walked to work -",
            "the highest proportion."
          ]
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "title": null,
      "axis": {
        "labelAngle": -45,
        "labelLimit": 230,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "Vehicles",
      "type": "nominal",
      "sort": [
        "Car, as driver",
        "Car, as passenger",
        "Train",
        "Bus",
        "Tram/light rail",
        "Ferry",
        "Taxi/ride-share service",
        "Truck",
        "Motorbike/scooter",
        "Bicycle",
        "Walked only",
        "Other Mode"
      ],
      "title": "Travel method",
      "axis": {
        "labelLimit": 220,
        "labelFontSize": 12
      }
    }
  }
}
